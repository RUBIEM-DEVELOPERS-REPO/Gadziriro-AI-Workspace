{
  "components": {
    "schemas": {
      "AuditVerifyOut": {
        "properties": {
          "broken_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Broken At"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "count"
        ],
        "title": "AuditVerifyOut",
        "type": "object"
      },
      "CreateSessionIn": {
        "description": "Body for creating a session.",
        "properties": {
          "allow_egress": {
            "default": false,
            "title": "Allow Egress",
            "type": "boolean"
          },
          "gpu_memory_mb": {
            "default": 0,
            "title": "Gpu Memory Mb",
            "type": "integer"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "CreateSessionIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HardwareReport": {
        "description": "Result of the installer hardware check (FR-27).",
        "properties": {
          "cpu_count": {
            "title": "Cpu Count",
            "type": "integer"
          },
          "disk_free_gb": {
            "title": "Disk Free Gb",
            "type": "number"
          },
          "gpu_count": {
            "title": "Gpu Count",
            "type": "integer"
          },
          "gpu_memory_mb": {
            "items": {
              "type": "integer"
            },
            "title": "Gpu Memory Mb",
            "type": "array"
          },
          "gpu_present": {
            "title": "Gpu Present",
            "type": "boolean"
          },
          "ram_mb": {
            "title": "Ram Mb",
            "type": "integer"
          },
          "recommended_model_sizes": {
            "items": {
              "type": "string"
            },
            "title": "Recommended Model Sizes",
            "type": "array"
          },
          "supported_methods": {
            "items": {
              "type": "string"
            },
            "title": "Supported Methods",
            "type": "array"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "gpu_present",
          "gpu_count",
          "cpu_count",
          "ram_mb",
          "disk_free_gb"
        ],
        "title": "HardwareReport",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "PrincipalOut": {
        "properties": {
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "username"
        ],
        "title": "PrincipalOut",
        "type": "object"
      },
      "RunCellIn": {
        "description": "Body for executing a single notebook cell.",
        "properties": {
          "code": {
            "default": "",
            "title": "Code",
            "type": "string"
          }
        },
        "title": "RunCellIn",
        "type": "object"
      },
      "SessionOut": {
        "properties": {
          "allow_egress": {
            "default": false,
            "title": "Allow Egress",
            "type": "boolean"
          },
          "gpu_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Gpu Ids",
            "type": "array"
          },
          "kernel_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kernel Id"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
